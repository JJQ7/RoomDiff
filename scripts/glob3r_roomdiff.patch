diff --git a/glob3r/inference/frames_export.py b/glob3r/inference/frames_export.py
new file mode 100644
index 0000000..1392c4b
--- /dev/null
+++ b/glob3r/inference/frames_export.py
@@ -0,0 +1,63 @@
+# --- RoomDiff patch (not upstream) -------------------------------------------------------------
+"""Per-frame export for --save_frames: dense depth, confidence and scale for EVERY input frame.
+
+Upstream --save_dense only writes a fused points_dense.ply from the keyframes. This writes
+frames.npz in Glob3R's processing order (the --unordered retrieval order; identity for ordered
+mode) together with the image path of every row, so rows map to input files by name.
+
+Arrays (N = all input frames, h x w = network resolution):
+  image_paths (N,) str   input image path of each row
+  order       (N,) int64 index of each row in the sorted input listing (unordered: `reorder`)
+  w2c         (N,4,4) float64 world-to-camera after the final BA (same as poses_final.txt, inverted)
+  K_orig      (N,3,3) float64 BA intrinsics in original-image pixels (one focal, centre principal point)
+  k1          (N,) float64 SIMPLE_RADIAL k1 (0 when BA used plain pinhole)
+  depth       (N,h,w) float32 z-depth = Pi3X local z (after the init normalisation) * scale
+  conf        (N,h,w) float32 sigmoid(Pi3X depth-confidence logit) in [0,1]
+  scale       (N,) float32 per-frame depth scale from recompute_depth_scales (RANSAC on BA points)
+  scale_points(N,) int64 BA points used for that scale; 0 means scale fell back to 1.0 (unreliable)
+  is_keyframe (N,) bool  frame is one of Glob3R's selected (anchor) keyframes
+  init_norm_scale ()     factor normalize_initial_poses applied to the (metric) Pi3X local points;
+                         depth / (init_norm_scale * scale) = the raw Pi3X metric z-depth of the
+                         window that initialised the frame
+  scale_wh    (2,) float64 original-to-network pixel scale (scale_w, scale_h)
+  net_hw      (2,) int64   network image size (h, w)
+  torch_peak_reserved_gb () float64 torch.cuda.max_memory_reserved() at export time (NaN without CUDA)
+"""
+import os
+
+import numpy as np
+import torch
+
+
+def save_frames_npz(estimator, save_path, image_path_list, order, scale_w, scale_h):
+    if not hasattr(estimator, "scale"):
+        estimator.recompute_depth_scales()
+    scale = torch.as_tensor(estimator.scale, dtype=torch.float32).reshape(-1)
+    depth = estimator.point_clouds_local[..., 2].float() * scale[:, None, None]
+    n = depth.shape[0]
+    k1 = torch.zeros(n, dtype=torch.float64)
+    dist = getattr(estimator, "distortion_coefficients", None)
+    if dist is not None and dist.numel() and dist.shape[-1] >= 1:
+        k1 = dist.reshape(n, -1)[:, 0].double()
+    is_kf = np.zeros(n, dtype=bool)
+    is_kf[list(estimator.selected_idx)] = True
+    np.savez_compressed(
+        os.path.join(save_path, "frames.npz"),
+        image_paths=np.array([str(p) for p in image_path_list]),
+        order=np.asarray(order, dtype=np.int64),
+        w2c=estimator.extrinsic_estimated.detach().cpu().double().numpy(),
+        K_orig=estimator.intrinsics.detach().cpu().double().numpy(),
+        k1=k1.cpu().numpy(),
+        depth=depth.detach().cpu().numpy().astype(np.float32),
+        conf=estimator.point_conf.detach().cpu().float().reshape(depth.shape).numpy(),
+        scale=scale.numpy(),
+        scale_points=np.asarray(getattr(estimator, "scale_num_points", [-1] * n), dtype=np.int64),
+        is_keyframe=is_kf,
+        init_norm_scale=np.float64(getattr(estimator, "init_norm_scale", np.nan)),
+        scale_wh=np.array([scale_w, scale_h], dtype=np.float64),
+        net_hw=np.array([estimator.h, estimator.w], dtype=np.int64),
+        torch_peak_reserved_gb=np.float64(torch.cuda.max_memory_reserved() / 2**30
+                                          if torch.cuda.is_available() else np.nan),
+    )
+    print(f"[save_frames] wrote {n} frames to {os.path.join(save_path, 'frames.npz')}")
+# --- end RoomDiff patch ------------------------------------------------------------------------
